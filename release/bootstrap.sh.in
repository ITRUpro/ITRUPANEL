#!/usr/bin/env bash
# Copyright (c) 2026 Oleg Sergeevich Dmitriev (Дмитриев Олег Сергеевич). ITRUPANEL. Licensed under GPL-3.0-only (SPDX-License-Identifier: GPL-3.0-only). See LICENSE.txt
# ITRUPANEL online installer. Publish this file as /panel/install-itrupanel.sh at itrupanel.com.
set -euo pipefail
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}"
RELEASE=0.2.13
ARCHIVE_SHA256=RELEASE_SHA256_PLACEHOLDER
BASE_URL=https://itrupanel.com/panel
fail() { echo "Ошибка: $*" >&2; exit 1; }

#ITRUPANEL_BANNER_PLACEHOLDER

# A shell opened by the panel belongs to itrupanel.service. Stopping that unit
# kills the shell and its children, so hand the work to a separate systemd unit.
detach_from_panel() {
  local group in_panel=0 stage unit logfile
  if [ -r /proc/self/cgroup ]; then
    while IFS= read -r group; do
      case "$group" in */itrupanel.service|*/itrupanel.service/*) in_panel=1 ;; esac
    done </proc/self/cgroup
  fi
  [ "$in_panel" = 1 ] || return 0
  command -v systemd-run >/dev/null || { echo 'Обновляйте из отдельной SSH-сессии: systemd-run не найден.' >&2; exit 1; }
  umask 077
  stage=$(mktemp -d /var/tmp/itrupanel-update.XXXXXXXX)
  unit="itrupanel-update-$(date +%Y%m%d-%H%M%S)-$$"
  logfile="/usr/local/itrupanel/var/$unit.log"
  if ! (
    set -e
    mkdir -p /usr/local/itrupanel/var || exit 1
    : >"$logfile" || exit 1
    cp -- "$0" "$stage/entry.sh" || exit 1
    cat >"$stage/run.sh" <<'WORKER'
#!/usr/bin/env bash
set -euo pipefail
stage="$(cd "$(dirname "$0")" && pwd)"
exec >>"$1" 2>&1
trap 'rm -rf -- "$stage"' EXIT
export TMPDIR="$stage"
echo 'Обновление выполняется отдельно от службы панели.'
bash "$stage/entry.sh"
WORKER
  ); then
    rm -rf -- "$stage"
    echo 'Не удалось подготовить независимое обновление. Панель не остановлена.' >&2
    exit 1
  fi
  echo 'Запускаю обновление в отдельной службе. Shell-клиент закроется при перезапуске панели.'
  echo "Журнал обновления: $logfile"
  echo "Проверка через SSH: systemctl status $unit --no-pager -l"
  if ! systemd-run --unit="$unit" --description='ITRUPANEL independent update' /bin/bash "$stage/run.sh" "$logfile"; then
    rm -rf -- "$stage"
    echo 'Отдельная служба не запущена. Обновление остановлено до изменения панели.' >&2
    exit 1
  fi
  echo 'Обновление передано systemd. Дождитесь завершения в журнале и откройте панель снова.'
  exit 0
}

main() {
  if [ "${1:-}" = --help ]; then
    echo 'Установка / обновление ITRUPANEL: bash install.sh (от root на Linux).'
    echo 'Новая установка: чистый VPS или выделенный сервер. PHP_VERSION=8.4 меняет версию PHP.'
    return
  fi
  [ "$#" = 0 ] || fail 'неизвестный параметр'
  [ "$(id -u)" = 0 ] || fail 'запустите команду из root-терминала сервера'
  [ "$(uname -s)" = Linux ] || fail 'установщик предназначен для Linux-сервера'
  [ -d /run/systemd/system ] || fail 'нужен Linux-сервер с systemd'
  case "$(uname -m)" in x86_64|amd64|aarch64|arm64) ;; *) fail 'поддерживаются amd64 и arm64' ;; esac
  [ -r /etc/os-release ] || fail 'не найдена информация об ОС'
  . /etc/os-release
  local family=''
  case " ${ID:-} ${ID_LIKE:-} " in
    *' debian '*|*' ubuntu '*) family=debian ;;
    *' rhel '*|*' centos '*|*' fedora '*|*' almalinux '*|*' rocky '*) family=rhel ;;
    *) fail "ОС ${PRETTY_NAME:-unknown} не поддерживается" ;;
  esac
  detach_from_panel
  command -v flock >/dev/null || fail 'нужна утилита flock из пакета util-linux'
  exec 9>/run/lock/itrupanel-installer.lock
  flock -n 9 || fail 'другой установщик ITRUPANEL уже запущен'
  command -v sha256sum >/dev/null || fail 'нужна утилита sha256sum из coreutils'
  local mode=install
  if [ -e /usr/local/itrupanel/etc/.admin-set ] || [ -e /etc/systemd/system/itrupanel.service ]; then
    # Never treat an initialized server with missing files as a fresh install.
    [ -x /usr/local/itrupanel/itrupanel ] && [ -s /usr/local/itrupanel/etc/state.json ] || fail 'найдена неполная установка; проверьте её перед повтором'
    mode=update
  elif [ -e /usr/local/itrupanel/itrupanel ] || [ -e /usr/local/itrupanel/etc/state.json ]; then
    # PHP setup may fail before state.json is first saved. Keep existing state.
    echo 'Найдена незавершённая установка. Повторяю настройку сервера.'
  fi
  # Логотип и проверка сервера; install.sh из архива не повторяет их (ITRUPANEL_BANNER=1).
  itru_banner
  itru_preflight "${PRETTY_NAME:-unknown}" "$(uname -m)" "$mode"
  # /tmp may be a small tmpfs. Keep download and extraction on /var/tmp.
  WORK_DIR=$(mktemp -d /var/tmp/itrupanel-download.XXXXXXXX) || fail 'не удалось создать рабочую папку в /var/tmp'
  trap 'rm -rf -- "$WORK_DIR"' EXIT
  trap 'echo "Установка не завершена. См. ошибку выше." >&2' ERR
  export TMPDIR="$WORK_DIR"
  local available_kb
  available_kb=$(df -Pk "$WORK_DIR" | awk 'NR == 2 {print $4}')
  case "$available_kb" in ''|*[!0-9]*) fail 'не удалось определить свободное место в /var/tmp' ;; esac
  [ "$available_kb" -ge 102400 ] || fail 'для скачивания и распаковки нужно не менее 100 МБ свободного места в /var/tmp'
  if ! command -v unzip >/dev/null || ! command -v curl >/dev/null; then
    if [ "$family" = debian ]; then
      export DEBIAN_FRONTEND=noninteractive
      apt-get -o Acquire::https::Timeout=20 -o Acquire::http::Timeout=20 -o Acquire::Retries=1 update
      apt-get -o DPkg::Lock::Timeout=60 install -y curl unzip ca-certificates
    else
      dnf --setopt=timeout=20 --setopt=retries=1 install -y curl unzip ca-certificates
    fi
  fi
  echo "==> Скачивание ITRUPANEL $RELEASE ($mode)"
  curl --fail --show-error --location --proto '=https' --proto-redir '=https' \
    --connect-timeout 15 --max-time 600 --retry 2 \
    "$BASE_URL/itrupanel-full-$RELEASE.zip" -o "$WORK_DIR/panel.zip"
  printf '%s  %s\n' "$ARCHIVE_SHA256" "$WORK_DIR/panel.zip" | sha256sum --check --status || fail 'контрольная сумма архива не совпала; установка остановлена'
  unzip -tq "$WORK_DIR/panel.zip" >/dev/null
  unzip -q "$WORK_DIR/panel.zip" -d "$WORK_DIR"
  [ -f "$WORK_DIR/itrupanel/$mode.sh" ] || fail 'неверная структура архива'
  bash "$WORK_DIR/itrupanel/$mode.sh"
}
# Do not execute a partially downloaded script.
main "$@"
